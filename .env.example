# ── Site ────────────────────────────────────────────────────────────────
# Public URL, used for canonical links, the sitemap and social previews.
SITE_URL=https://araksan.com
# Only "production" allows search engines to index the site. Leave unset on
# staging and local machines.
SITE_ENV=
# When set, the whole site asks for this password (any username). Use it for
# the private staging link; leave empty in production.
STAGING_PASSWORD=
# Where editable content, backups and uploaded images are kept. Must be a
# persistent, backed-up directory on the server.
STORAGE_DIR=./storage

# ── Admin panel (/admin) ────────────────────────────────────────────────
# Generate with: npm run admin:credentials -- "a long passphrase" [--totp]
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional two-step sign-in (authenticator app code).
ADMIN_TOTP_SECRET=

# ── Contact form (sent with Resend, https://resend.com) ─────────────────
# Enquiries are emailed and not stored on the server.
# API key from resend.com → API Keys (sending access is enough).
RESEND_API_KEY=
# Where enquiries go. Several addresses can be separated by commas.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "ARAKSAN website <website@araksan.com>".
# Leave empty to use Resend's test sender, which only delivers to the
# Resend account owner's own address.
CONTACT_FROM_EMAIL=
